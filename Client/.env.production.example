# Copy to Client/.env.production and fill in real values.
# Client/.env.production is gitignored — never commit the real file.

DJANGO_SECRET_KEY=changeme-generate-a-real-secret
DEBUG=False
DJANGO_ALLOWED_HOSTS=wallet-demo.gbcode.dev

# Register an OAuth2 Application in the production wallet admin
# (https://wallet.gbcode.dev/admin/) — Confidential, Authorization code grant,
# redirect URI https://wallet-demo.gbcode.dev/callback/, algorithm RS256 —
# then paste the generated Client ID/Secret here.
CLIENT_ID=
CLIENT_SECRET=
WALLET_BASE_URL=https://wallet.gbcode.dev
CLIENT_REDIRECT_URI=https://wallet-demo.gbcode.dev/callback/
