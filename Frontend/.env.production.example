# NOTE: these are Vite VITE_* vars — inlined into the JS bundle at BUILD time,
# not read at container runtime. When building the Frontend Docker image they
# must be passed as build ARGs (see docker-compose.yml's frontend build.args),
# not via env_file. Changing a value requires an image rebuild, not just a
# container restart.
#
# Copy to Frontend/.env.production and fill in real values.
# Frontend/.env.production is gitignored — never commit the real file.

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=https://wallet.gbcode.dev/auth/callback/google

# Leave blank in production — the demo auto-login widget should not exist in
# production builds.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
