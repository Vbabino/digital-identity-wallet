# Root-level compose file. Copy to .env.production at the repo root.
# Read by `docker compose --env-file .env.production ...` for variable
# interpolation in docker-compose.yml (POSTGRES_PASSWORD, and the Frontend's
# VITE_* build args — env_file: does NOT feed build.args, so these must be
# interpolated here instead).
#
# Keep POSTGRES_PASSWORD in sync with the password embedded in
# Backend/.env.production's DATABASE_URL — they are not automatically linked.

POSTGRES_PASSWORD=changeme

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=https://wallet.gbcode.dev/auth/callback/google
