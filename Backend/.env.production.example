# Copy to Backend/.env.production and fill in real values.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=changeme-generate-with-django.core.management.utils.get_random_secret_key
DJANGO_ALLOWED_HOSTS=wallet.gbcode.dev

# postgres://<user>:<password>@<host>:<port>/<database>
# In docker-compose the hostname is the "postgres" service name (Docker internal DNS).
DATABASE_URL=postgres://walletuser:changeme@postgres:5432/wallet

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate a FRESH RSA private key for production
# committed in Backend/.env, which is dev-only.
OIDC_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Where the frontend SPA is served from. Drives AUTH_KIT's social login/connect
# callback URLs and the email-verification/password-reset links.
FRONTEND_BASE_URL=https://wallet.gbcode.dev

# Comma-separated. Must include both the wallet SPA origin and the OAuth2
# client simulator origin (which is a genuine cross-origin relying party).
CORS_ALLOWED_ORIGINS=https://wallet.gbcode.dev,https://wallet-demo.gbcode.dev
CSRF_TRUSTED_ORIGINS=https://wallet.gbcode.dev,https://wallet-demo.gbcode.dev

# Transactional email via Resend's HTTP API (django-anymail), not SMTP —
# DigitalOcean blocks outbound SMTP ports (25/465/587) by default, which left
# registration/password-reset requests hanging until the gunicorn worker
# timeout (surfaced to clients as a 504). HTTPS (443) is not blocked.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@gbcode.dev
